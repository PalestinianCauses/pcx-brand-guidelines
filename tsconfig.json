{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowJs": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.cts", "**/*.mts", "**/*.mjs"],
  "exclude": ["node_modules"]
}
